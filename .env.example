# ---------------------------------------------------------------------------
# Ustawienia INFRASTRUKTURALNE. Skopiuj ten plik do .env i dostosuj.
#
# Ustawienia użytkownika (imię asystenta, kolor GUI, cechy charakteru, głos,
# RVC) NIE są tutaj — mieszkają w config/user_settings.json.
#
# Żadna wartość nie jest wymagana: wszystkie mają sensowne domyślne.
# Nie wpisuj tu ścieżek z konkretnego komputera — katalogi programu są
# wyznaczane automatycznie względem katalogu projektu.
# ---------------------------------------------------------------------------

# --- Tryb offline ---
# auto = tryb offline włącza się sam, gdy model Whisper jest już w models/whisper
# on   = nic nigdy nie jest pobierane (twarda gwarancja pracy bez sieci)
# off  = wolno pobrać brakujący model przy pierwszym użyciu mikrofonu
# Przyjmowane są też wartości logiczne: true/false, 1/0, tak/nie.
# Komplet do pracy bez sieci przygotowuje: python scripts/prepare_offline.py
OFFLINE_MODE=auto

# --- Model językowy (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=10m
# Czy asystent ma SAM uruchomić lokalną Ollamę, gdy ta nie odpowiada. Dzięki
# temu nie trzeba trzymać drugiego okna terminala tylko po to, żeby stało w nim
# `ollama serve`. NIGDY nie dotyczy serwera na innej maszynie: gdy OLLAMA_HOST
# wskazuje na inny komputer, asystent mówi o tym i niczego tam nie uruchamia.
OLLAMA_AUTOSTART=true
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.7
# -1 = bez limitu długości odpowiedzi
OLLAMA_MAX_TOKENS=1024
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=120

# --- Rozpoznawanie mowy (Whisper) ---
WHISPER_MODEL=small
# auto = użyj CUDA, jeśli jest wykryta i faktycznie działa; inaczej CPU
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# puste = automatyczne rozpoznanie języka; "pl" lub "en" wymusza konkretny.
# UWAGA: to ustawienie techniczne. Preferowany język mowy asystenta jest w
# config/user_settings.json (pole speech_language) i ma pierwszeństwo.
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
# false = nigdy nie pobieraj modelu z sieci (musi już być w models/whisper).
# OFFLINE_MODE=on wyłącza pobieranie niezależnie od tej wartości.
WHISPER_ALLOW_DOWNLOAD=true
WHISPER_MIN_DURATION_S=0.35
WHISPER_MAX_NO_SPEECH_PROB=0.75
# Po ilu sekundach CISZY zwolnić model Whispera z pamięci (i z VRAM-u, gdy liczy
# na GPU). Model wczytany „na wszelki wypadek" nie zużywa cykli, ale trzyma
# kilkaset MB — na laptopie z 8 GB i jednym GPU to jest różnica między działającą
# grą a swapem. Wraca sam przy pierwszej wypowiedzi (koszt ok. 1–3 s).
# Zwalniany jest TYLKO model główny; mały model detektora frazy zostaje.
# 0 = nigdy nie zwalniaj.
WHISPER_IDLE_UNLOAD_S=300

# --- Wejście: klawiatura czy mikrofon ---
# text = wpisywanie (domyślnie), voice = nasłuch mikrofonu od startu.
# W trakcie rozmowy przełącza to komenda /mic.
INPUT_MODE=text
MIC_ENABLED=true
# Fragment NAZWY urządzenia (nie indeks!). Puste = domyślne urządzenie systemu.
# Listę nazw pokazuje komenda /mic lista.
AUDIO_INPUT_DEVICE=
AUDIO_SAMPLE_RATE=16000
# Długość ramki: 10, 20 albo 30 ms (wymóg webrtcvad)
AUDIO_FRAME_MS=20
AUDIO_QUEUE_SECONDS=30
AUDIO_SUPPRESS_DEVICE_WARNINGS=true

# --- Słowo aktywujące (Faza 3) ---
# Sama FRAZA jest w config/user_settings.json (pole wake_word) — tutaj tylko
# mechanika. Puste wake_word = „hej <assistant_name>".
WAKE_ENABLED=true
# auto = openWakeWord, jeśli jest pakiet i model dla frazy; inaczej detektor
# whisperowy (działa z DOWOLNĄ frazą, bez trenowania modelu)
WAKE_ENGINE=auto
# Model Whispera używany tylko do wykrywania frazy.
# Puste = ten sam co główny (oszczędza pamięć, kosztem czasu detekcji).
# „tiny" był tu domyślny do czasu pomiaru na korpusie 480 transkrypcji: wykrywał
# frazę w 20% przypadków, bo imię asystenta zapisywał jako „tymiku" albo „micu".
# „base" z podpowiedzią frazy i ciszą na brzegach daje 95% przy zerze fałszywych
# pobudek, kosztem ~0,3 s na wypowiedź.
WAKE_WHISPER_MODEL=base
# Podobieństwo tekstu do frazy uznawane za trafienie (0..1). Niżej = łatwiej
# wybudzić, ale częściej z przypadku.
WAKE_SIMILARITY=0.72
# Osobny, WYŻSZY próg dla samego imienia asystenta. Fraza „hej Miku" ma dwa
# człony i pomyłka w jednym da się wybaczyć; samo „Miku" to jedno krótkie słowo,
# więc przy tym samym progu co wyżej wyzwalałoby się na „biku", „niku", „i ty".
WAKE_NAME_SIMILARITY=0.80
# Próg pewności openWakeWord (inna skala niż powyższa)
WAKE_OPENWAKEWORD_THRESHOLD=0.5
# Dłuższych wypowiedzi nie sprawdzamy pod kątem frazy — to rozmowa, nie zawołanie
WAKE_MAX_UTTERANCE_S=4
# Ile sekund po wybudzeniu można mówić bez powtarzania frazy
WAKE_WINDOW_S=30

# --- Synteza mowy (Faza 4) ---
# UWAGA: tutaj jest sama MECHANIKA. Wybór głosu należy do użytkownika i mieszka
# w config/user_settings.json (piper_model, piper_voices, voice_speed,
# voice_volume) — podmiana głosu nie wymaga dotykania tego pliku.
TTS_ENABLED=true
# Katalog z modelami głosów Pipera (pliki .onnx + .onnx.json). Puste = szukaj
# automatycznie: models/piper w projekcie, potem katalogi danych systemu
# (XDG_DATA_HOME/.local/share, %LOCALAPPDATA%, ~/Library/Application Support).
# Wpisz własną ścieżkę, jeśli trzymasz głosy gdzie indziej.
PIPER_VOICES_DIR=
# Ścieżka do programu `piper` albo sama nazwa polecenia. Puste = szukaj w PATH
# i obok głosów. Używane tylko wtedy, gdy nie ma pakietu `piper-tts`.
PIPER_BINARY=
# Mówienie zdaniami: pierwsze zdanie leci do głośnika, gdy model pisze kolejne.
# false = synteza dopiero po całej odpowiedzi (prościej, ale słychać ją później).
TTS_STREAM_SENTENCES=true
# Krótsze fragmenty czekają na dalszy ciąg (0 = mów każde zdanie z osobna).
TTS_MIN_SENTENCE_CHARS=24
# Wypowiedź bez interpunkcji jest dzielona twardo po tylu znakach.
TTS_MAX_SENTENCE_CHARS=320
# Limit czasu syntezy jednego fragmentu przez binarkę Pipera.
TTS_TIMEOUT_S=60
# Fragment NAZWY urządzenia wyjściowego (nie indeks!). Puste = domyślne.
# Wykryte urządzenia wypisuje: python main.py --check-deps
AUDIO_OUTPUT_DEVICE=
AUDIO_OUTPUT_QUEUE_SECONDS=10

# --- Wykrywanie mowy (VAD) ---
# auto = webrtcvad, jeśli zainstalowany; inaczej wbudowany detektor energetyczny
VAD_ENGINE=auto
VAD_AGGRESSIVENESS=2
VAD_ENERGY_THRESHOLD_DB=8
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=700
VAD_PREROLL_MS=300
VAD_MAX_UTTERANCE_S=20
VAD_LISTEN_TIMEOUT_S=30

# --- Tryb bezobsługowy (python main.py --headless) ---
# Usługa w tle: tylko mikrofon i mowa, bez okna i bez klawiatury. Pod systemd
# --user (Linux) i Harmonogram zadań (Windows) — żadne z nich nie wymaga
# uprawnień administratora. Instalacja: python scripts/install_autostart.py
#
# Ile sekund czekać przy starcie na serwer modelu. Usługa użytkownika startuje
# razem z sesją, często ZANIM Ollama zdąży się podnieść. 0 = nie czekaj.
HEADLESS_OLLAMA_WAIT_S=60
# Odstęp między próbami odzyskania nasłuchu po awarii mikrofonu.
HEADLESS_RETRY_S=15
# Długość jednego okna nasłuchu. Między oknami pętla sprawdza, czy nie przyszedł
# SIGTERM — czyli TA wartość, a nie VAD_LISTEN_TIMEOUT_S, decyduje, jak szybko
# kończy się `systemctl --user stop`. MUSI być wyraźnie mniejsza niż
# TimeoutStopSec w pliku jednostki (domyślnie 30 s), inaczej systemd dobija
# proces SIGKILL-em w środku sprzątania. Rozpoczętej wypowiedzi NIE przerywa.
HEADLESS_LISTEN_SLICE_S=5
# Czy usługa ma się przywitać na głos przy starcie. Domyślnie NIE: usługa
# startuje razem z logowaniem i powitanie odzywałoby się przy każdym włączeniu
# komputera.
HEADLESS_GREETING=false

# --- Aplikacja ---
# Język odpowiedzi asystenta: en | pl | auto
# Wpisany kod OBOWIĄZUJE — przy LANGUAGE=en pytanie zadane po polsku również
# dostaje odpowiedź po angielsku. LANGUAGE=auto (albo "speech_language": "auto"
# w config/user_settings.json) włącza rozpoznawanie języka każdej wypowiedzi.
LANGUAGE=en
# Język INTERFEJSU: napisy w oknie, komunikaty w terminalu, raport zależności.
# To coś innego niż LANGUAGE — można mieć angielski interfejs i polskie odpowiedzi
# (albo odwrotnie). Obsługiwane: en | pl | auto ("auto" = idź za LANGUAGE).
# Z wiersza poleceń jednorazowo: python main.py --ui-lang pl
UI_LANGUAGE=en
# Czy `python main.py` bez argumentów ma otwierać okno zamiast terminala.
# Domyślnie tak. Bez Tk albo bez sesji graficznej asystent schodzi do terminala
# sam, z jednym komunikatem. Flagi --gui i --no-gui mają pierwszeństwo.
GUI_ENABLED=true
LOG_LEVEL=INFO
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3

# --- Historia rozmowy ---
# Okno rozmowy trzymane w pamięci. To z niego powstają streszczenia (Faza 5)
# i to ono opisuje rozmowę dla człowieka.
HISTORY_MAX_MESSAGES=40
HISTORY_MAX_CHARS=12000

# Ile z tego okna trafia DO MODELU w jednej turze. To NIE to samo co limity
# wyżej: okno jest większe, a do modelu idzie ostatni fragment, bo na słabszej
# maszynie każdy dodatkowy tysiąc tokenów promptu to sekundy czekania. Starsze
# tury nie znikają — wracają streszczeniem i przypomnieniem semantycznym
# w bloku kontekstu, który tym limitom NIE podlega.
#
# Bieżące pytanie nigdy nie wypada, a wynik narzędzia nigdy nie zostaje bez
# swojego wywołania (model dostałby wynik „znikąd").
#
# 0 = bez dodatkowego limitu (do modelu idzie całe okno).
LLM_HISTORY_MAX_MESSAGES=16
LLM_HISTORY_MAX_CHARS=6000

# --- Pamięć długoterminowa (Faza 5) ---
# Baza SQLite: rozmowy, streszczenia, fakty o użytkowniku, preferencje, notatki.
# false = nic nie jest zapisywane na dysk (asystent pamięta tylko bieżącą sesję).
MEMORY_ENABLED=true
# Plik bazy. PUSTE = katalog danych właściwy dla Twojego systemu:
#   Linux/BSD:  $XDG_DATA_HOME/miku-assistant  (domyślnie ~/.local/share/miku-assistant)
#   macOS:      ~/Library/Application Support/miku-assistant
#   Windows:    %LOCALAPPDATA%\miku-assistant
# Ścieżkę można podać własną (względna liczy się od katalogu projektu);
# wartość :memory: trzyma bazę wyłącznie w RAM-ie (nic nie przetrwa).
DATABASE_PATH=
# Ile sekund czekać, gdy bazę trzyma zajętą druga instancja asystenta.
DATABASE_TIMEOUT_S=5
# Kopia pliku bazy przed każdą serią migracji schematu.
DATABASE_BACKUP_BEFORE_MIGRATION=true
# Gdy rozmowa przekroczy limity z sekcji wyżej, starsze wiadomości są STRESZCZANE
# przez model, a nie po prostu obcinane. false = zachowanie z Fazy 1 (obcinanie).
MEMORY_SUMMARY_ENABLED=true
# Po przekroczeniu limitu okno rozmowy jest przycinane do tego ułamka limitu —
# dzięki zapasowi streszczanie odpala się rzadko, a nie w co drugiej turze.
MEMORY_TRIM_RATIO=0.75
# Maksymalna długość streszczenia (znaki).
MEMORY_SUMMARY_MAX_CHARS=1500
# Ile faktów i preferencji doklejać do promptu systemowego.
MEMORY_CONTEXT_FACTS=20
# Automatyczne zapominanie rozmów starszych niż tyle dni. 0 = trzymaj wszystko.
# Fakty, preferencje i notatki NIE są kasowane — to pamięć trwała.
MEMORY_RETENTION_DAYS=0

# --- Pamięć semantyczna: embeddingi (Faza 6) ---
# Wspomnienia odnajdywane po ZNACZENIU, nie po słowach. Wszystko liczone
# lokalnie — treść rozmów nie opuszcza tego komputera i nie ma tu (ani nie
# będzie) żadnego API chmurowego.
EMBEDDINGS_ENABLED=true
# auto = sentence-transformers, jeśli pakiet jest zainstalowany; inaczej Ollama.
# Dopuszczalne: auto | sentence-transformers | ollama | none
EMBEDDING_ENGINE=auto
# Model dla sentence-transformers. Domyślny jest wielojęzyczny (rozumie polski)
# i mały. Pobierz zawczasu: python scripts/prepare_offline.py --embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Model embeddingów w Ollamie (wariant bez PyTorcha): ollama pull nomic-embed-text
EMBEDDING_OLLAMA_MODEL=nomic-embed-text
# Urządzenie obliczeniowe: auto | cpu | cuda | mps
# auto = wybór zostawiony bibliotece (pyta PyTorcha, więc nie narzuci CUDA tam,
# gdzie sterownik jest, a PyTorch zbudowany bez CUDA). mps = układy Apple M*.
EMBEDDING_DEVICE=auto
# Czym liczyć podobieństwo: auto | faiss | numpy
# numpy omija FAISS bez odinstalowywania go — koła faiss-cpu są budowane pod
# AVX2 i na starszym procesorze potrafią przerwać proces, a nie zgłosić błąd.
VECTOR_INDEX=auto
EMBEDDING_BATCH_SIZE=16
EMBEDDING_ALLOW_DOWNLOAD=true
# Ile wspomnień doklejać do promptu i od jakiego podobieństwa (0..1).
# Wyżej = mniej, ale trafniejszych skojarzeń.
MEMORY_RECALL_LIMIT=5
MEMORY_RECALL_MIN_SCORE=0.35
# Czy indeksować wypowiedzi użytkownika (wektor i tak powstaje przy wyszukiwaniu).
MEMORY_EMBED_MESSAGES=true
# Informacja uznana przez model za chwilową („dziś pracuję z domu") dostaje
# termin ważności zamiast miejsca w pamięci na zawsze. 0 = traktuj jak trwałą.
MEMORY_TRANSIENT_TTL_HOURS=24

# --- Narzędzia i uprawnienia (Faza 7) ---
# Model może zlecać działania (na razie jedno: odczyt godziny). Każde wywołanie
# przechodzi przez brain/tool_router.py: walidacja argumentów → polityka →
# ewentualna zgoda użytkownika → wykonanie z limitem czasu → wpis w audycie.
# Model NIGDY nie wykonuje kodu ani poleceń poza tą drogą.
TOOLS_ENABLED=true
# Lista dozwolonych narzędzi po przecinku albo * (wszystkie zarejestrowane).
TOOLS_ALLOWED=*
# Wyłączone imiennie — ma pierwszeństwo nad TOOLS_ALLOWED.
TOOLS_DISABLED=
# Ile wywołań narzędzi wolno w jednej turze (ochrona przed pętlą).
TOOLS_MAX_CALLS_PER_TURN=6
# Twardy limit czasu jednego wywołania; nie ma wariantu „bez limitu".
TOOL_TIMEOUT_S=15
# Ile znaków wyniku narzędzia wpuszczamy do promptu (resztę obcinamy).
TOOL_RESULT_MAX_CHARS=4000
# Od jakiego poziomu ryzyka pytać użytkownika o zgodę: SAFE | MEDIUM | HIGH.
# Wartość można tylko OBNIŻYĆ — HIGH i CRITICAL wymagają zgody zawsze.
SECURITY_REQUIRE_CONFIRM_FROM=HIGH
# Narzędzia CRITICAL (nieodwracalne, systemowe). Domyślnie wyłączone i nawet nie
# pokazywane modelowi.
SECURITY_ALLOW_CRITICAL=false
# Jak długo żądanie zgody jest ważne. Zgoda po tym czasie nie działa.
SECURITY_CONFIRM_TIMEOUT_S=60
# Log wywołań narzędzi (tabela tool_audit w bazie, tylko do dopisywania).
SECURITY_AUDIT_ENABLED=true
# Tryb próbny: narzędzia zwracają podgląd zamiast działać.
SECURITY_DRY_RUN=false

# --- Narzędzia systemowe (Faza 8) ---
# Katalogi, w których narzędzia plikowe (fs.*, pdf.*, open.path, shell.run) mogą
# cokolwiek robić. Lista rozdzielona średnikami albo przecinkami, ŚCIEŻKI
# BEZWZGLĘDNE. Puste = tylko katalog roboczy asystenta
# (<katalog danych>/workspace) — czyli żaden prywatny plik użytkownika.
# Poza tymi katalogami nic nie istnieje: „..", „~" i dowiązania symboliczne
# wyprowadzające na zewnątrz są odrzucane.
FS_ALLOWED_ROOTS=
# Limity odczytu, zapisu, listowania i usuwania.
FS_MAX_READ_BYTES=200000
FS_MAX_WRITE_BYTES=200000
FS_MAX_ENTRIES=200
# Ile wpisów wolno usunąć jednym wywołaniem (katalog rekurencyjnie).
FS_MAX_DELETE_ENTRIES=50
# Schematy adresów, które wolno otworzyć narzędziem open.url. „file" świadomie
# pominięty — pliki otwiera open.path, pilnując dozwolonych katalogów.
LAUNCHER_ALLOWED_SCHEMES=http,https,mailto
# Programy, które wolno uruchomić narzędziem shell.run (nazwy, nie ścieżki).
# PUSTA LISTA = narzędzie jest wyłączone i model go nie widzi. To domyślny stan.
# Uwaga: shell.run i tak jest poziomu CRITICAL, więc wymaga dodatkowo
# SECURITY_ALLOW_CRITICAL=true i pełnej frazy potwierdzenia. Potoki, przekierowania
# i „bash -c" nie są obsługiwane — to warunek działania twardych blokad.
SHELL_ALLOWED_BINARIES=
SHELL_TIMEOUT_S=20
SHELL_MAX_OUTPUT_CHARS=4000
# Ile stron PDF-a wolno przeczytać jednym wywołaniem (wymaga pakietu pypdf).
PDF_MAX_PAGES=20

# --- Narzędzia sieciowe (Faza 9) ---
# Wyłączenie zostawia asystenta z narzędziami lokalnymi. Uwaga na różnicę:
# OFFLINE_MODE=on wyłącza sieć CAŁKOWICIE (twarda gwarancja), a OFFLINE_MODE=auto
# dotyczy tylko pobierania modeli — nie odbiera prawa zapytania o pogodę.
WEB_ENABLED=true
WEB_TIMEOUT_S=15
# Limit pobieranych bajtów i limit tekstu wpuszczanego do promptu — dwie różne
# rzeczy: strona bywa duża, a modelowi wystarczy jej treść.
WEB_MAX_BYTES=2000000
WEB_MAX_CHARS=6000
WEB_MAX_REDIRECTS=3
# Puste = „miku-assistant/wersja". Niektóre serwisy odrzucają nieznane programy.
WEB_USER_AGENT=
# Adresy prywatne (localhost, 192.168.x.x, 169.254.169.254) są ZABLOKOWANE —
# inaczej model dałby się namówić na własną Ollamę albo na metadane maszyny
# w chmurze. Włączaj TYLKO dla własnej instancji SearXNG w sieci domowej.
WEB_ALLOW_PRIVATE_HOSTS=false

# Wyszukiwanie: duckduckgo (bez klucza) | searxng (własna instancja) | none
SEARCH_PROVIDER=duckduckgo
SEARCH_BASE_URL=
SEARCH_MAX_RESULTS=5

# Pogoda: open-meteo nie wymaga klucza API (razem z geokodowaniem nazw miast).
WEATHER_PROVIDER=open-meteo
# Miejsce używane, gdy użytkownik nie poda żadnego („jaka jest pogoda?").
WEATHER_DEFAULT_LOCATION=
WEATHER_UNITS=metric

# Wiadomości: lista kanałów RSS (przecinki albo średniki). Puste = tylko szukanie.
NEWS_FEEDS=
# Szablon szukania wiadomości; {query} i {language} są podstawiane. Domyślnie
# kanał Google News — jeden wpis wymienia go na dowolny inny serwis.
NEWS_SEARCH_URL=https://news.google.com/rss/search?q={query}&hl={language}
NEWS_MAX_ITEMS=8

# YouTube: transkrypcje działają bez klucza, szukanie wymaga Data API v3.
YOUTUBE_MAX_RESULTS=5

# --- Klucze API (Faza 9) ---
# Wszystkie OPCJONALNE. Brak klucza wyłącza dokładnie te narzędzia, które go
# wymagają — i nic więcej. Klucze są przechowywane jako SecretStr i NIGDY nie
# trafiają do logu: każdy wpis w logach przechodzi przez filtr redakcji, także
# wpisy bibliotek (httpx zapisuje pełne adresy żądań).
# Nie wpisuj kluczy nigdzie poza tym plikiem — .env nie trafia do repozytorium.
YOUTUBE_API_KEY=
WEATHER_API_KEY=
NEWS_API_KEY=
SEARCH_API_KEY=

# --- Interfejs graficzny (Faza 10) ---
# Uwaga: WYGLĄD okna (kolory) NIE jest tutaj. Motyw powstaje z pola
# "ui_accent_color" w config/user_settings.json, bo to preferencja użytkownika,
# a nie ustawienie maszyny. Tutaj są wyłącznie rzeczy zależne od komputera.
#
# Tryb jasności: system, dark, light. "system" pyta system operacyjny — na
# części pulpitów Linuksa nie ma jak tego odczytać i wtedy używany jest ciemny.
GUI_THEME_MODE=system
# Skalowanie interfejsu. 0 = automat (DPI wykryte przez toolkit). Wpisz wartość
# (np. 1.25) tylko wtedy, gdy automat nie trafia: Wayland ze skalowaniem
# frakcyjnym, zdalny pulpit, ekran 4K na stacji dokującej.
GUI_SCALING=0
# Krój pisma okna. Puste = wybór z krojów FAKTYCZNIE zainstalowanych na tej
# maszynie; nieistniejąca nazwa jest ignorowana z ostrzeżeniem w logu.
GUI_FONT_FAMILY=
# Rozmiar okna "SZEROKOŚĆxWYSOKOŚĆ", np. 1280x800. Puste = dopasowanie do
# ekranu (okno nigdy nie jest większe niż rozdzielczość monitora).
GUI_WINDOW_SIZE=

# ---------------------------------------------------------------------------
# Opcjonalne nadpisania katalogów — przydatne, gdy katalog programu jest tylko
# do odczytu (instalacja systemowa). Zostaw puste, jeśli nie wiesz, po co to.
# ---------------------------------------------------------------------------
# MIKU_CONFIG_DIR=
# MIKU_LOGS_DIR=
# MIKU_MODELS_DIR=
# Katalog na dane zapisywane przez program (baza pamięci). Puste = katalog
# danych Twojego systemu; ta zmienna ma pierwszeństwo przed nim.
# MIKU_DATA_DIR=
#
# Trzy poniższe działają WYŁĄCZNIE jako zmienne środowiskowe i wpisanie ich
# tutaj nic nie da — są czytane, zanim ten plik zostanie wczytany (MIKU_ENV_FILE
# wskazuje przecież na niego samego), albo przez skrypty powłoki, które o nim
# nie wiedzą. Ustaw je w powłoce przed uruchomieniem:
#
#   MIKU_ENV_FILE=/etc/miku/env        inny plik konfiguracyjny niż ./.env
#   MIKU_VENV_DIR=/opt/miku/venv       środowisko Pythona poza projektem
#   MIKU_WHEELHOUSE_DIR=/mnt/kola      magazyn kół pip do instalacji bez sieci

# --- Pluginy (Faza 11) -------------------------------------------------------
# Rozszerzenia z katalogu plugins/. Każdy plugin rejestruje własne narzędzia i
# przechodzi przez TEN SAM router i te same potwierdzenia co narzędzia wbudowane.
PLUGINS_ENABLED=true
# Allowlista nazw po przecinku albo „*" (wszystkie znalezione).
PLUGINS_ALLOWED=*
# Lista wyłączonych — ma pierwszeństwo nad PLUGINS_ALLOWED.
PLUGINS_DISABLED=
# Dodatkowy katalog z własnymi pluginami spoza repozytorium. Puste = tylko
# plugins/ w projekcie. Ścieżka względna liczy się od katalogu projektu.
PLUGINS_EXTRA_DIR=

# Plugin: przypomnienia. Działa w całości lokalnie, wymaga włączonej pamięci
# trwałej (MEMORY_ENABLED), bo przypomnienia mają przetrwać restart.
REMINDERS_POLL_S=20
REMINDERS_MAX_ACTIVE=100
REMINDERS_KEEP_DAYS=30

# Plugin: Home Assistant. PUSTY adres = plugin nieaktywny i model nie widzi jego
# narzędzi. Token to long-lived access token z profilu użytkownika w Home
# Assistancie — traktuj go jak hasło (nie trafia do logów ani do raportu).
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_S=10
# Domeny encji, których przełączenie wymaga potwierdzenia użytkownika. Wartości
# stąd DODAJĄ się do wbudowanych — literówka nie obniży wymagań dla zamka.
HOME_ASSISTANT_HIGH_RISK_DOMAINS=lock,cover,gate,alarm_control_panel,valve,water_heater
HOME_ASSISTANT_MAX_ENTITIES=60
